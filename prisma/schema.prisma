generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  discordId       String?   @unique
  username        String    @default("")
  discriminator   String    @default("0")
  avatarUrl       String?
  bio             String?   @db.Text
  websiteUrl      String?
  twitterHandle   String?
  githubHandle    String?
  isPublicProfile Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  servers      Server[]
  reviews      Review[]
  subscription Subscription?

  // NextAuth required fields
  accounts Account[]
  sessions Session[]

  @@index([discordId])
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Servers ──────────────────────────────────────────────────────────────────

model Server {
  id          String  @id @default(cuid())
  guildId     String  @unique
  ownerId     String
  name        String
  description String  @db.Text
  shortDesc   String  @db.VarChar(160)
  iconUrl     String?
  bannerUrl   String?
  inviteUrl   String
  memberCount Int     @default(0)
  isNsfw      Boolean @default(false)
  isPublished Boolean @default(false)
  isPremium   Boolean @default(false)
  bumpedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tags      ServerTag[]
  bumps     BumpHistory[]
  reviews   Review[]
  botConfig BotConfig?

  @@index([ownerId])
  @@index([isPublished, isNsfw])
}

// ─── Tags ─────────────────────────────────────────────────────────────────────

model Tag {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  isPredefined Boolean   @default(false)
  color        String?
  createdAt    DateTime  @default(now())

  servers ServerTag[]

  @@index([slug])
}

model ServerTag {
  serverId   String
  tagId      String
  isCustom   Boolean  @default(false)
  assignedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serverId, tagId])
  @@index([tagId])
}

// ─── Bump History ─────────────────────────────────────────────────────────────

model BumpHistory {
  id         String     @id @default(cuid())
  serverId   String
  bumpedById String?
  source     BumpSource @default(BOT)
  bumpedAt   DateTime   @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, bumpedAt(sort: Desc)])
}

enum BumpSource {
  BOT
  DASHBOARD
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  serverId  String
  authorId  String
  rating    Int
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([serverId, authorId])
  @@index([serverId, createdAt(sort: Desc)])
}

// ─── Bot Config ───────────────────────────────────────────────────────────────

model BotConfig {
  id            String   @id @default(cuid())
  serverId      String   @unique
  guildId       String   @unique
  bumpChannelId String?
  logChannelId  String?
  bumpRoleId    String?
  updatedAt     DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}
