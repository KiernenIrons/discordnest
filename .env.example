# ─── Database ────────────────────────────────────────────────────────────────
# Get a free Postgres DB from https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/discordnest"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Your site's URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─── Discord OAuth ───────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → Your App → OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ─── Stripe ──────────────────────────────────────────────────────────────────
# From https://dashboard.stripe.com/apikeys (use sk_test_ for dev)
STRIPE_SECRET_KEY=""
# From Stripe dashboard (use pk_test_ for dev) — safe to expose to client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=""
# The Price ID of your $4.99/mo product (price_...)
STRIPE_PRICE_ID=""

# ─── UploadThing ─────────────────────────────────────────────────────────────
# From https://uploadthing.com/dashboard
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ─── Bot ↔ API Shared Secret ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must match BOT_API_SECRET in bot/.env
BOT_API_SECRET=""

# ─── Upstash Redis (optional — for rate limiting) ────────────────────────────
# From https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
